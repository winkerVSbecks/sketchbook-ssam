{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    // vite 8 ships its types only via "exports", which node10 resolution ignores
    "paths": { "vite": ["./node_modules/vite/dist/node/index.d.ts"] }
  },
  "include": ["src"]
}
